---
import Layout from "../../layouts/layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getAllProjects } from "../../data/projects"; // ← faltaba este import

const projects = getAllProjects();
---

<Layout
  title="Projects - CC"
  description="Check out my latest projects and work"
>
  <section class="min-h-screen py-24 px-6 dark:bg-gray-800">
    <div class="max-w-5xl mx-auto">
      <!-- Header -->
      <div class="mb-16 text-center">
        <h1
          class="text-4xl md:text-5xl font-bold text-gray-700 dark:text-white"
        >
          My Projects
        </h1>
      </div>

      <!-- Projects List -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          projects.map((project) => (
            <ProjectCard
              slug={project.slug}
              title={project.title}
              shortDescription={project.shortDescription}
              technologies={project.technologies}
            />
          ))
        }
      </div>

      <!-- Empty State -->
      {
        projects.length === 0 && (
          <div class="text-center py-20">
            <div class="text-6xl mb-4">🚧</div>
            <h3 class="text-2xl font-bold text-white mb-2">
              Projects Coming Soon
            </h3>
            <p class="text-gray-400">
              I'm currently working on some exciting projects. Check back soon!
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

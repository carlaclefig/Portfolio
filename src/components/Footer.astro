---
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-white/90 dark:bg-gray-900/90
         backdrop-blur-md
         shadow-[0_-4px_10px_rgba(0,0,0,0.10)]
         dark:shadow-[0_-4px_10px_rgba(0,0,0,0.15)]
         text-gray-700 dark:text-gray-300
         py-3 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-6">
    <!-- Top Row -->
    <div
      class="flex flex-col md:flex-row justify-center items-center gap-2 md:gap-6 text-center"
    >
      <!-- Logo -->
      <h3
        class="text-lg md:text-xl font-bold
               bg-linear-to-r from-blue-500 to-blue-400
               bg-clip-text text-transparent whitespace-nowrap"
      >
        CC.
      </h3>

      <!-- Description -->
      <p
        class="text-xs sm:text-sm md:text-base text-gray-400 dark:text-gray-400 leading-relaxed max-w-xl"
      >
        Designing and developing digital experiences with a focus on
        functionality, aesthetics, and attention to detail.
      </p>
    </div>

    <!-- Bottom -->
    <div class="mt-2 text-center">
      <p class="text-[11px] sm:text-xs md:text-sm text-gray-500">
        © {currentYear} Carla Clemente | Built with
        <span class="text-blue-400 font-semibold">Astro</span> and
        <span class="text-blue-400 font-semibold">Tailwind CSS</span>
      </p>
    </div>
  </div>
</footer>
